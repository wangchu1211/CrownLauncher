{
  "name": "crown-launcher",
  "version": "0.2.0",
  "private": true,
  "author": "CrownEngine",
  "description": "Crown project manager and desktop launcher",
  "main": "dist/Main/index.js",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && npm run typecheck && npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "dev": "npm run build && electron .",
    "start": "electron .",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "package": "npm run build && electron-builder --win dir",
    "package:all": "npm run build && electron-builder"
  },
  "dependencies": {},
  "devDependencies": {
    "@vitejs/plugin-react": "6.0.5",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "7.0.2",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  },
  "build": {
    "appId": "CrownEngine.CrownLauncher",
    "productName": "Crown Launcher",
    "asar": true,
    "directories": {
      "output": "Build/Electron"
    },
    "files": [
      "dist/**/*",
      "Resources/app-icon.png"
    ],
    "win": {
      "executableName": "CrownLauncher",
      "icon": "Resources/app-icon.ico",
      "target": [
        "dir"
      ]
    }
  }
}
